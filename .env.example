NODE_ENV=development
PORT=3000

# Comma-separated allowed browser origins for production API calls.
# Leave empty when the Express server serves the built frontend from the same origin.
CORS_ORIGIN=

# Maximum JSON request body size. Audio/image uploads are sent as base64.
API_BODY_LIMIT=25mb

# Only set true for local/internal testing. Never enable on a public production host.
ENABLE_DEV_AUTH=false
VITE_ENABLE_DEV_MODE=false

# AI chat service: Alibaba Cloud DashScope OpenAI-compatible endpoint.
CHAT_API_KEY=sk-xxxxxxxxxxxxxxxx
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.6-flash
CHAT_REPORT_MODEL=qwen3.6-plus

# Audio transcription service: DashScope Qwen ASR.
# CHAT_API_KEY is used first. Leave AUDIO_API_KEY empty when both use Alibaba Cloud Model Studio.
AUDIO_API_KEY=
AUDIO_MODEL=qwen3-asr-flash
AUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AUDIO_LANGUAGE=zh
AUDIO_ENABLE_ITN=false

# AMap weather/geocoding API key.
WEATHER_API_KEY=xxxxxxxxxxxxxxxx

# Supabase/MemFire backend auth validation.
MEMFIRE_URL=https://xxxxxxxx.memfiredb.com
MEMFIRE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only key for administrator account management.
# Never expose this to Vite/frontend code. Keep it only in the Node.js runtime env.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Vite frontend Supabase/MemFire client config.
VITE_MEMFIRE_URL=https://xxxxxxxx.memfiredb.com
VITE_MEMFIRE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Production checklist:
# - Run supabase-schema.sql once in the MemFire/Supabase SQL editor.
# - Create the first admin user in Auth, then run the bootstrap insert at the end of supabase-schema.sql.
# - Disable public signup in the MemFire/Supabase Auth console.
# - Keep ENABLE_DEV_AUTH=false and VITE_ENABLE_DEV_MODE=false on public hosts.
